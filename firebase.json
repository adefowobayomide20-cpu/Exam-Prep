{
  "flutter": {"platforms": {"android": {"default": {"projectId": "exam-prep-ng", "appId": "1:734285493928:android:fe940beec1a9baa038749d", "fileOutput": "android/app/google-services.json"}}, "dart": {"lib/firebase_options.dart": {"projectId": "exam-prep-ng", "configurations": {"android": "1:734285493928:android:fe940beec1a9baa038749d", "ios": "1:734285493928:ios:2ce70288e6d643d338749d", "macos": "1:734285493928:ios:2ce70288e6d643d338749d", "web": "1:734285493928:web:ef4dd3fa2f41a1fa38749d"}}}}},
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "flutter",
      "public": "build/web",
      "ignore": ["firebase.json", "**/.*", "!**/.well-known/**", "**/node_modules/**", "**/*.symbols"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        }
      ]
    },
    {
      "target": "webnext",
      "source": "web-next",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ]
}